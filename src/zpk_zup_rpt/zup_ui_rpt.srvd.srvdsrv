@EndUserText.label: 'Upload Analytics Service (FI + PP)'
define service ZUP_UI_RPT {
  expose ZUP_C_FIUPLOAD_RPT as FIUploadReport;
  expose ZUP_C_PPUPLOAD_RPT as PPUploadReport;
  expose ZUP_C_FIUPLOAD_ITEM as FIUploadItem;
  expose ZUP_C_UPLOAD_KPI as UploadKPI;
  expose zih_c_batch as BatchMonitor;
  expose zih_c_map_h as MappingConfig;
  expose zih_c_map_i as MappingField;
}