managed implementation in class zmm_cl_bp_gr unique;
strict ( 2 );

define behavior for zmm_i_gr_h alias GrUpload
persistent table zmm_tb_gr_h
lock master
authorization master ( instance )
etag master LastChangedAt
{
  update;

  static action uploadExcel
    parameter ZD_GRUPLOADPARAM
    result [1] ZD_GR_UPLOAD_RESULT;

  action ( features : instance ) retryPost parameter ZD_GR_RETRY_PARAM;

  field ( readonly )
  GrNumber, BatchId, Status, Message,
  MaterialDocument, MaterialDocumentYear,
  StatusCriticality, LogHandle,
  CreatedAt, CreatedBy, LastChangedAt, LastChangedBy, LocalLastChangedAt;
  static action getMyAuth parameter ZD_GR_AUTH_PARAM result [1] ZD_GR_MY_AUTH;
  association _items;

}

define behavior for zmm_i_gr_i alias GrItem
persistent table zmm_tb_gr_i
lock dependent by _header
authorization dependent by _header
etag dependent by _header
{
  field ( readonly )
  GrNumber, Item, PoNumber, PoItem, Material, Plant, Batch,
  ReceiveQty, Unit, StorageLocation, OrderQty, OpenQty,
  Status, StatusCriticality, Message,
  MaterialDocument, MaterialDocumentItem, MaterialDocumentYear;

  association _header;
}